@page "/inventory/create"
@inject InventoryService InventoryService
@inject NotificationService NotificationService
@inject TechnicalErrorNotifier Errors
@inject NavigationManager Navigation

<PageTitle>New inventory item</PageTitle>

<RadzenStack Gap="1.5rem" Style="max-width: 680px">

    <RadzenStack Gap="0.75rem">
        <RadzenButton Icon="arrow_back" Variant="Variant.Text" Text="Back to inventory"
                      ButtonStyle="ButtonStyle.Base" class="rz-p-0 back-link"
                      Click="@(() => Navigation.NavigateTo("/"))" />
        <RadzenStack Gap="0.25rem" class="page-header">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">New item</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="page-subtitle">
                Add a new piece of equipment to the inventory.
            </RadzenText>
        </RadzenStack>
    </RadzenStack>

    <RadzenCard>
        @* The form catches typing mistakes early. The rules that must always hold (unique serial
           number, existing category) are enforced by the service and reported below. *@
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <RadzenStack Gap="1.25rem">
                <div>
                    <RadzenFormField Text="Serial number" Variant="Variant.Outlined" Style="width: 100%">
                        <Start><RadzenIcon Icon="qr_code_2" /></Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="_model.SerialNumber" MaxLength="255" data-test="serial-number" />
                        </ChildContent>
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.SerialNumber)" class="validation-message rz-color-danger" />
                    <p class="form-hint">Unique per item. Stored in upper case.</p>
                </div>

                <div>
                    <RadzenFormField Text="Name" Variant="Variant.Outlined" Style="width: 100%">
                        <Start><RadzenIcon Icon="label" /></Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="_model.ItemName" MaxLength="255" data-test="item-name" />
                        </ChildContent>
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.ItemName)" class="validation-message rz-color-danger" />
                </div>

                <div>
                    <RadzenFormField Text="Category" Variant="Variant.Outlined" Style="width: 100%">
                        <Start><RadzenIcon Icon="category" /></Start>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="_model.CategoryId" Data="@_categories"
                                            TextProperty="Text" ValueProperty="Id" Placeholder="Select a category"
                                            data-test="category" />
                        </ChildContent>
                    </RadzenFormField>
                    <ValidationMessage For="@(() => _model.CategoryId)" class="validation-message rz-color-danger" />
                </div>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenSwitch @bind-Value="_model.IsAvailable" Name="isAvailable" />
                    <RadzenLabel Text="Can be lent right away" Component="isAvailable" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Create item" Icon="save"
                                  ButtonStyle="ButtonStyle.Primary" IsBusy="@_submitting" Disabled="@_submitting"
                                  data-test="create-item" />
                    <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" Variant="Variant.Flat"
                                  ButtonStyle="ButtonStyle.Light" Disabled="@_submitting"
                                  Click="@(() => Navigation.NavigateTo("/"))" />
                </RadzenStack>
            </RadzenStack>
        </EditForm>
    </RadzenCard>
</RadzenStack>

@code {
    private readonly InventoryItemFormModel _model = new();
    private IReadOnlyList<LookupEntry> _categories = [];
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await InventoryService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Errors.Report(ex, "Could not load categories");
        }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            var id = await InventoryService.AddInventoryItemAsync(_model.ToCommand());
            NotificationService.Notify(NotificationSeverity.Success, "Item created",
                $"'{_model.ItemName.Trim()}' was added to the inventory.");
            Navigation.NavigateTo($"/inventory/{id}");
        }
        catch (BusinessRuleException ex)
        {
            // The form stays open and keeps its values, so the user only fixes what was wrong.
            NotificationService.Notify(NotificationSeverity.Error, "Could not create item", ex.Message);
        }
        catch (Exception ex)
        {
            Errors.Report(ex, "Could not create item");
        }
        finally
        {
            _submitting = false;
        }
    }
}
