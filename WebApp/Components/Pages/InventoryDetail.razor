@page "/inventory/{Id:int}"
@inject InventoryService InventoryService
@inject LoanDialogs LoanDialogs
@inject TechnicalErrorNotifier Errors
@inject NavigationManager Navigation

<PageTitle>@(_details?.Item.ItemName ?? $"Item {Id}")</PageTitle>

<RadzenStack Gap="1.5rem">

    <RadzenStack Gap="0.75rem">
        <RadzenButton Icon="arrow_back" Variant="Variant.Text" Text="Back to inventory"
                      ButtonStyle="ButtonStyle.Base" class="rz-p-0 back-link"
                      Click="@(() => Navigation.NavigateTo("/"))" />
        <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" class="page-header rz-m-0">
            @(_details?.Item.ItemName ?? $"Item {Id}")
        </RadzenText>
    </RadzenStack>

    @if (_loading)
    {
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
    }
    else if (_loadFailed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" data-test="item-load-failed">
            This item could not be loaded. @TechnicalErrorNotifier.Advice
        </RadzenAlert>
    }
    else if (_details is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" data-test="item-not-found">
            No inventory item with id @Id exists.
        </RadzenAlert>
    }
    else
    {
        var item = _details.Item;

        <RadzenCard>
            <RadzenStack Gap="1.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                    <ItemStatusBadge Item="@item" ShowBorrower="false" />
                    @if (item.CurrentLoan is { } loan)
                    {
                        <RadzenButton Text="Take back" Icon="assignment_return" ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => ReturnAsync(item, loan))" data-test="return-item" />
                    }
                    else if (item.IsAvailable)
                    {
                        <RadzenButton Text="Lend" Icon="assignment_ind" ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => LendAsync(item))" data-test="lend-item" />
                    }
                </RadzenStack>

                <RadzenRow RowGap="1.5rem">
                    <RadzenColumn Size="12" SizeMd="4">
                        <p class="field-label">Serial number</p>
                        <p class="field-value" data-test="detail-serial">@item.SerialNumber</p>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMd="4">
                        <p class="field-label">Category</p>
                        <p class="field-value">@item.Category</p>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMd="4">
                        <p class="field-label">Times lent</p>
                        <p class="field-value">@_details.History.Count</p>
                    </RadzenColumn>
                    @if (item.CurrentLoan is { } currentLoan)
                    {
                        <RadzenColumn Size="12" SizeMd="4">
                            <p class="field-label">Lent to</p>
                            <p class="field-value" data-test="detail-borrower">@currentLoan.PersonName · @currentLoan.SchoolClass</p>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMd="4">
                            <p class="field-label">Lent on</p>
                            <p class="field-value">@Format.Date(currentLoan.LoanDate)</p>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMd="4">
                            <p class="field-label">Due back</p>
                            <p class="field-value">@Format.Date(currentLoan.DueDate)</p>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Loan history</RadzenText>
            <LoanHistoryGrid Entries="@_details.History" />
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter] public int Id { get; set; }

    private InventoryItemDetails? _details;
    private bool _loading = true;
    // Distinguishes "the item does not exist" from "we could not find out".
    private bool _loadFailed;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _details = await InventoryService.GetItemAsync(Id);
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Errors.Report(ex, "Could not load item");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LendAsync(InventoryItemSummary item)
    {
        if (await LoanDialogs.LendAsync(item.Id, item.ItemName, item.SerialNumber))
            await LoadAsync();
    }

    private async Task ReturnAsync(InventoryItemSummary item, CurrentLoan loan)
    {
        if (await LoanDialogs.ReturnAsync(loan.ReservationId, item.ItemName, loan.PersonName, loan.LoanDate))
            await LoadAsync();
    }
}
